<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Activar moneda Bolívares (VES) -->
        <record id="base.VES" model="res.currency">
            <field name="active" eval="True"/>
        </record>
        
        <!-- Asignar RIF al contacto de la compañía para pasar la validación -->
        <record id="base.main_partner" model="res.partner">
            <field name="vat">J-123456789</field>
        </record>
        
        <!-- Forzar a la Compañía Principal a usar Venezuela -->
        <record id="base.main_company" model="res.company">
            <field name="country_id" ref="base.ve"/>
        </record>

        <!-- Crear un diario de ventas básico para que no falle la facturación de prueba -->
        <record id="demo_sales_journal" model="account.journal">
            <field name="name">Ventas Ridery</field>
            <field name="code">RID</field>
            <field name="type">sale</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Cuenta de Ingresos -->
        <record id="demo_income_account" model="account.account">
            <field name="name">Ingresos por Servicios de Transporte</field>
            <field name="code">400000</field>
            <field name="account_type">income</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <!-- Producto de Servicio -->
        <record id="product_ridery_trip" model="product.product">
            <field name="name">Servicio de Transporte Ridery</field>
            <field name="type">service</field>
            <field name="default_code">RIDERY_TRIP</field>
            <field name="property_account_income_id" ref="demo_income_account"/>
        </record>
    </data>
</odoo>
