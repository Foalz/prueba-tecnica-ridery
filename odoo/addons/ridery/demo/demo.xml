<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================================================================== -->
        <!-- PASAJEROS                                                          -->
        <!-- ================================================================== -->
        
        <record id="demo_passenger_1" model="res.partner">
            <field name="name">Pasajero Demo 1 (Altamira)</field>
            <field name="vat">V-12345678</field>
            <field name="phone">+58 412 111 2233</field>
            <field name="email">pasajero1@demo.ridery</field>
        </record>

        <record id="demo_passenger_2" model="res.partner">
            <field name="name">Pasajero Demo 2 (Las Mercedes)</field>
            <field name="vat">V-23456789</field>
            <field name="phone">+58 414 444 5566</field>
            <field name="email">pasajero2@demo.ridery</field>
        </record>

        <!-- ================================================================== -->
        <!-- CONDUCTORES                                                        -->
        <!-- ================================================================== -->

        <record id="demo_driver_1" model="res.partner">
            <field name="name">Conductor Demo 1 (Corolla)</field>
            <field name="vat">V-87654321</field>
            <field name="phone">+58 424 777 8899</field>
            <field name="email">conductor1@demo.ridery</field>
        </record>

        <record id="demo_driver_2" model="res.partner">
            <field name="name">Conductor Demo 2 (Optra)</field>
            <field name="vat">V-98765432</field>
            <field name="phone">+58 416 999 0011</field>
            <field name="email">conductor2@demo.ridery</field>
        </record>

        <!-- ================================================================== -->
        <!-- VEHÍCULOS (FLOTA)                                                  -->
        <!-- ================================================================== -->

        <record id="demo_brand_toyota" model="fleet.vehicle.model.brand">
            <field name="name">Toyota</field>
        </record>

        <record id="demo_model_corolla" model="fleet.vehicle.model">
            <field name="name">Corolla</field>
            <field name="brand_id" ref="demo_brand_toyota"/>
        </record>

        <record id="demo_brand_chevrolet" model="fleet.vehicle.model.brand">
            <field name="name">Chevrolet</field>
        </record>

        <record id="demo_model_optra" model="fleet.vehicle.model">
            <field name="name">Optra</field>
            <field name="brand_id" ref="demo_brand_chevrolet"/>
        </record>

        <!-- Asignación de vehículos a los conductores para que sean reconocidos como Ridery Drivers -->
        <record id="demo_vehicle_1" model="fleet.vehicle">
            <field name="model_id" ref="demo_model_corolla"/>
            <field name="license_plate">ABC-123</field>
            <field name="driver_id" ref="demo_driver_1"/>
        </record>

        <record id="demo_vehicle_2" model="fleet.vehicle">
            <field name="model_id" ref="demo_model_optra"/>
            <field name="license_plate">XYZ-987</field>
            <field name="driver_id" ref="demo_driver_2"/>
        </record>

        <!-- ================================================================== -->
        <!-- VIAJES DE DEMOSTRACIÓN                                             -->
        <!-- ================================================================== -->

        <!-- Viaje 1: Finalizado con 4 paradas (Inicio, 2 intermedias, Fin) -->
        <record id="demo_trip_1" model="ridery.trips">
            <field name="partner_id" ref="demo_passenger_1"/>
            <field name="driver_partner_id" ref="demo_driver_1"/>
            <field name="distance">8.4</field>
            <field name="price">15.50</field>
            <field name="state">done</field>
            <!-- Inyectando paradas (O2M) directamente -->
            <field name="stop_ids" eval="[
                (0, 0, {'name': 'Plaza Altamira', 'stop_type': 'start', 'latitude': 10.4965, 'longitude': -66.8488, 'sequence': 1}),
                (0, 0, {'name': 'C.C. San Ignacio', 'stop_type': 'intermediate', 'latitude': 10.4920, 'longitude': -66.8520, 'sequence': 2}),
                (0, 0, {'name': 'Centro Lido', 'stop_type': 'intermediate', 'latitude': 10.4880, 'longitude': -66.8550, 'sequence': 3}),
                (0, 0, {'name': 'C.C. Sambil', 'stop_type': 'end', 'latitude': 10.4855, 'longitude': -66.8570, 'sequence': 4})
            ]"/>
        </record>

        <!-- Viaje 2: En Progreso con 2 paradas (Inicio y Fin) -->
        <record id="demo_trip_2" model="ridery.trips">
            <field name="partner_id" ref="demo_passenger_2"/>
            <field name="driver_partner_id" ref="demo_driver_2"/>
            <field name="distance">12.1</field>
            <field name="price">22.00</field>
            <field name="state">in_progress</field>
            <field name="stop_ids" eval="[
                (0, 0, {'name': 'Las Mercedes', 'stop_type': 'start', 'latitude': 10.4800, 'longitude': -66.8650, 'sequence': 1}),
                (0, 0, {'name': 'El Hatillo', 'stop_type': 'end', 'latitude': 10.4280, 'longitude': -66.8220, 'sequence': 2})
            ]"/>
        </record>

    </data>
</odoo>
