<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_ridery_trips" model="ir.module.category">
            <field name="name">Ridery Operaciones</field>
            <field name="description">Niveles de acceso para la gestión de viajes de Ridery.</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_ridery_trips_user" model="res.groups">
            <field name="name">Usuario (Despachador)</field>
            <field name="category_id" ref="module_category_ridery_trips"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Puede crear, leer y modificar viajes. No puede eliminar.</field>
        </record>

        <record id="group_ridery_trips_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_ridery_trips"/>
            <field name="implied_ids" eval="[(4, ref('group_ridery_trips_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Acceso total a la gestión de viajes, incluyendo eliminación.</field>
        </record>
    </data>
</odoo>
