<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_partner_ridery_trips_button" model="ir.ui.view">
            <field name="name">res.partner.ridery.trips.button</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button class="oe_stat_button"
                            type="object"
                            name="action_view_trips_as_passenger"
                            icon="fa-user"
                            attrs="{'invisible': [('trip_passenger_count', '=', 0)]}">
                        <field string="Pasajero" name="trip_passenger_count" widget="statinfo"/>
                    </button>

                    <button class="oe_stat_button"
                            type="object"
                            name="action_view_trips_as_driver"
                            icon="fa-car"
                            attrs="{'invisible': [('trip_driver_count', '=', 0)]}">
                        <field string="Conductor" name="trip_driver_count" widget="statinfo"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
