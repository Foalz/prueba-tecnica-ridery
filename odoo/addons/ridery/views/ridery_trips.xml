<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════ TREE ═══════════════════════════════════════ -->
        <record id="view_ridery_trips_tree" model="ir.ui.view">
            <field name="name">ridery.trips.tree</field>
            <field name="model">ridery.trips</field>
            <field name="arch" type="xml">
                <tree string="Viajes"
                      decoration-info="state == 'draft'"
                      decoration-success="state == 'in_progress'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="partner_id" string="Pasajero"/>
                    <field name="driver_partner_id" string="Conductor"/>

                    <field name="distance" sum="Total Distancia"/>
                    <field name="price" sum="Total Ingresos"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'in_progress'"
                           decoration-warning="state == 'confirmed'"
                           decoration-danger="state == 'cancelled'"/>
                    <field name="move_id" optional="show"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <!-- ═══════════════════════ FORM ═══════════════════════════════════════ -->
        <record id="view_ridery_trips_form" model="ir.ui.view">
            <field name="name">ridery.trips.form</field>
            <field name="model">ridery.trips</field>
            <field name="arch" type="xml">
                <form string="Viaje">
                    <header>
                        <button name="action_create_invoice" string="Facturar Viaje" type="object" class="oe_highlight" attrs="{'invisible': ['|', ('move_id', '!=', False), ('state', 'not in', ['confirmed', 'in_progress'])]}" groups="account.group_account_invoice"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Detalles del Viaje">

                                <field name="distance"/>
                                <field name="price"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="move_id" attrs="{'invisible': [('move_id', '=', False)]}"/>
                            </group>
                            <group string="Asignación de Conductor">
                                <field name="partner_id" string="Pasajero (Cualquiera)"/>
                                <field name="driver_partner_id" domain="[('is_ridery_driver', '=', True)]"/>
                                <field name="vehicle_id" readonly="1"/>
                                <field name="driver_license_plate" readonly="1"/>
                                <field name="fleet_category_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Paradas">
                                <field name="stop_ids">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="stop_type"/>
                                        <field name="name"/>
                                        <field name="latitude" optional="show"/>
                                        <field name="longitude" optional="show"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <div class="oe_chatter">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════ KANBAN ═══════════════════════════════════ -->
        <record id="view_ridery_trips_kanban" model="ir.ui.view">
            <field name="name">ridery.trips.kanban</field>
            <field name="model">ridery.trips</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column" sample="1">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="driver_partner_id"/>
                    <field name="state"/>
                    <field name="price"/>
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge rounded-pill text-bg-primary">
                                        <field name="price" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <span><strong>Pasajero: </strong><field name="partner_id"/></span><br/>
                                    <span><strong>Conductor: </strong><field name="driver_partner_id"/></span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══════════════════════ SEARCH ═══════════════════════════════════ -->
        <record id="view_ridery_trips_search" model="ir.ui.view">
            <field name="name">ridery.trips.search</field>
            <field name="model">ridery.trips</field>
            <field name="arch" type="xml">
                <search string="Buscar Viajes">
                    <field name="name" string="Referencia"/>
                    <field name="partner_id" string="Pasajero"/>
                    <field name="driver_partner_id" string="Conductor"/>
                    <field name="driver_license_plate" string="Placa"/>

                    <filter string="Mis Viajes" name="my_trips"
                            domain="[('create_uid', '=', uid)]"/>
                    <separator/>
                    <filter string="En Progreso" name="in_progress"
                            domain="[('state', '=', 'in_progress')]"/>
                    <filter string="Confirmados" name="confirmed"
                            domain="[('state', '=', 'confirmed')]"/>
                    <filter string="Cancelados" name="cancelled"
                            domain="[('state', '=', 'cancelled')]"/>

                    <group expand="0" string="Agrupar Por">
                        <filter string="Estado" name="group_by_state"
                                context="{'group_by': 'state'}"/>
                        <filter string="Conductor" name="group_by_driver"
                                context="{'group_by': 'driver_partner_id'}"/>
                        <filter string="Pasajero" name="group_by_customer"
                                context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════ ACTION ═══════════════════════════════════ -->
        <record id="action_ridery_trips" model="ir.actions.act_window">
            <field name="name">Gestión de Viajes</field>
            <field name="res_model">ridery.trips</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_ridery_trips_search"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                ¡Crea el primer viaje de Ridery!
              </p>
            </field>
        </record>

        <!-- ═══════════════════════ GRAPH ════════════════════════════════════ -->
        <record id="view_ridery_trips_graph" model="ir.ui.view">
            <field name="name">ridery.trips.graph</field>
            <field name="model">ridery.trips</field>
            <field name="arch" type="xml">
                <graph string="Análisis de Viajes" type="bar" sample="1">
                    <field name="driver_partner_id" type="row"/>
                    <field name="price" type="measure"/>
                    <field name="distance" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ═══════════════════════ REPORT ACTION ════════════════════════════ -->
        <record id="action_ridery_trips_report" model="ir.actions.act_window">
            <field name="name">Análisis de Viajes</field>
            <field name="res_model">ridery.trips</field>
            <field name="view_mode">graph,pivot</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                No hay datos suficientes para mostrar el análisis de viajes.
              </p>
            </field>
        </record>

    </data>
</odoo>
